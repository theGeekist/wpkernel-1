{
	"name": "@wpkernel/pipeline",
	"version": "2.0.0",
	"description": "Framework-agnostic pipeline orchestration primitives for WPKernel",
	"license": "EUPL-1.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/wpkernel/wpkernel.git",
		"directory": "packages/pipeline"
	},
	"homepage": "https://wpkernel.dev/packages/pipeline.html",
	"bugs": {
		"url": "https://github.com/wpkernel/wpkernel/issues"
	},
	"keywords": [
		"pipeline",
		"dataflow",
		"dag",
		"orchestration",
		"typescript"
	],
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=20.0.0"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"tag": "latest"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./v1": {
			"types": "./dist/v1.d.ts",
			"import": "./dist/v1.js",
			"default": "./dist/v1.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc --project tsconfig.json --noEmit",
		"clean": "rm -rf dist dist-tests *.tsbuildinfo",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"qualify:packed": "node scripts/qualify-packed-api.mjs",
		"test": "wpk-run-jest",
		"test:coverage": "wpk-run-jest coverage",
		"test:integration": "wpk-run-jest integration",
		"test:watch": "wpk-run-jest --watch",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"typecheck:tests": "wpk-run-typecheck-tests"
	},
	"devDependencies": {
		"@wpkernel/scripts": "workspace:*",
		"fast-check": "^4.9.0"
	}
}
